function TabBar({ tabs, active, onChange }) {
  return (
    <div style={{ display: "flex", gap: 4, background: "#070b07", padding: 4, borderRadius: 10, border: `1px solid ${COLORS.cardBorder}` }}>
      {tabs.map((t) => (
        <button
          key={t}
          onClick={() => onChange(t)}
          style={{
            flex: 1,
            padding: "8px 12px",
            background: active === t ? COLORS.accentDim : "transparent",
            border: "none",
            borderRadius: 7,
            color: active === t ? COLORS.accent : COLORS.textMuted,
            cursor: "pointer",
            fontSize: 12,
            fontWeight: active === t ? 700 : 400,
            letterSpacing: 0.5,
            transition: "all 0.2s",
          }}
        >
          {t}
        </button>
      ))}
    </div>
  );
}

