          {/* SUB-PROMPTS */}
          {activeTab === "Sub-Prompts" && (
            <div>
              <div style={{ marginBottom: 16 }}>
                <TabBar tabs={categories} active={category} onChange={setCategory} />
              </div>
              <div style={{ display: "flex", flexDirection: "column", gap: 10 }}>
                {filtered.map((p) => <PromptCard key={p.id} prompt={p} />)}
              </div>
            </div>
          )}

          {/* KNOWLEDGE BASE */}
          {activeTab === "Knowledge Base" && (
            <div>
              <div style={{ background: COLORS.card, border: `1px solid ${COLORS.cardBorder}`, borderRadius: 12, padding: 20, marginBottom: 16 }}>
                <div style={{ fontSize: 11, color: COLORS.warning, letterSpacing: 2, marginBottom: 8 }}>⚠ RECALIBRATION TEXT</div>
                <p style={{ color: COLORS.textMuted, fontSize: 12, marginBottom: 16, lineHeight: 1.6 }}>
                  If your AI starts giving generic, non-Indian, or expensive food advice — copy and paste this entire block to reset its logic.
                </p>
                <div style={{
                  background: "#070b07", borderRadius: 8, padding: 14,
                  fontSize: 11, color: COLORS.textMuted, lineHeight: 1.9,
                  whiteSpace: "pre-wrap", border: `1px solid ${COLORS.cardBorder}`,
                }}>
                  {KNOWLEDGE_BASE}
                </div>
                <div style={{ marginTop: 12, display: "flex", justifyContent: "flex-end" }}>
                  <CopyButton text={KNOWLEDGE_BASE} label="COPY KNOWLEDGE BASE" />
                </div>
              </div>

              {/* Protein cheat sheet */}
              <div style={{ background: COLORS.card, border: `1px solid ${COLORS.cardBorder}`, borderRadius: 12, padding: 20 }}>
                <div style={{ fontSize: 11, color: COLORS.accentDim, letterSpacing: 2, marginBottom: 14 }}>PROTEIN CHEAT SHEET (INDIA)</div>
                <div style={{ display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(140px, 1fr))", gap: 10 }}>
                  {[
                    { name: "Soy Chunks", protein: "52g", per: "100g dry", price: "~₹8" },
                    { name: "Whole Eggs", protein: "6g", per: "1 egg", price: "~₹7" },
                    { name: "Milma Curd", protein: "3.5g", per: "100g", price: "~₹4" },
                    { name: "Moong Dal", protein: "24g", per: "100g dry", price: "~₹12" },
                    { name: "Rajma", protein: "22g", per: "100g dry", price: "~₹10" },
                    { name: "Chicken Breast", protein: "31g", per: "100g", price: "~₹25" },
                  ].map((item) => (
                    <div key={item.name} style={{
                      background: "#070b07", borderRadius: 8, padding: 12,
                      border: `1px solid ${COLORS.cardBorder}`, textAlign: "center",
                    }}>
                      <div style={{ color: COLORS.text, fontWeight: 700, fontSize: 12 }}>{item.name}</div>
                      <div style={{ color: COLORS.accent, fontSize: 20, fontWeight: 700, margin: "4px 0" }}>{item.protein}</div>
                      <div style={{ color: COLORS.textMuted, fontSize: 10 }}>{item.per}</div>
                      <div style={{ color: COLORS.accentDim, fontSize: 11, marginTop: 4 }}>{item.price}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}
        </div>

        {/* Footer */}
        <div style={{ textAlign: "center", marginTop: 32, color: COLORS.textMuted, fontSize: 10, letterSpacing: 2 }}>
          AI NUTRITIONIST KIT v2.0 // IMPROVED EDITION
        </div>
      </div>
    </div>
  );
}
